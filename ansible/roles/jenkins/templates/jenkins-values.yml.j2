# =============================================================================
# Jenkins Helm Values — jenkins/jenkins chart
# =============================================================================
# Managed by Ansible — do not edit manually.
# =============================================================================

controller:
  image:
    tag: "lts"
  imagePullPolicy: IfNotPresent

  # Service configuration — NodePort for host access
  serviceType: NodePort
  nodePort: {{ jenkins_nodeport }}
  servicePort: {{ jenkins_http_port }}
  agentListenerPort: 50000

  # Let Helm create and manage the ServiceAccount (RBAC is in prereqs)
  serviceAccount:
    create: true
    name: jenkins

  # Use the pre-created NFS-backed PVC
  # persistence is at root level
  
# Top level persistence configuration
persistence:
  enabled: true
  existingClaim: "jenkins-home"

  # Security context matching the NFS export permissions
  securityContext:
    fsGroup: 1000
    runAsUser: 1000
    runAsGroup: 1000

  # JVM options
  javaOpts: "-Djenkins.install.runSetupWizard=true"

  # Skip default plugin installation for faster startup
  installPlugins: false
