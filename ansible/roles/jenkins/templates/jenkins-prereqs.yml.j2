# =============================================================================
# Jenkins prerequisites — Namespaces, RBAC, NFS PV/PVC
# =============================================================================
# These resources are NOT managed by the Helm chart. They must exist before
# the Helm install runs.
# =============================================================================
apiVersion: v1
kind: Namespace
metadata:
  name: {{ jenkins_namespace }}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ todo_namespace }}
---
# ---------- RBAC: Jenkins agent management (within jenkins namespace) --------
# NOTE: The ServiceAccount "jenkins" is created by the Helm chart.
# We only define Roles/RoleBindings that the chart does not provide.
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: jenkins-agent-manager
  namespace: {{ jenkins_namespace }}
rules:
  - apiGroups: [""]
    resources: ["pods", "pods/exec", "pods/log"]
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
  - apiGroups: [""]
    resources: ["configmaps", "events", "secrets"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: jenkins-agent-manager
  namespace: {{ jenkins_namespace }}
subjects:
  - kind: ServiceAccount
    name: jenkins
    namespace: {{ jenkins_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: jenkins-agent-manager
---
# ---------- RBAC: Jenkins deployer (within todo-app namespace) ---------------
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: jenkins-todo-deployer
  namespace: {{ todo_namespace }}
rules:
  - apiGroups: ["apps"]
    resources: ["deployments"]
    verbs: ["get", "list", "watch", "patch", "update"]
  - apiGroups: ["apps"]
    resources: ["replicasets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["pods", "services", "events"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: jenkins-todo-deployer
  namespace: {{ todo_namespace }}
subjects:
  - kind: ServiceAccount
    name: jenkins
    namespace: {{ jenkins_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: jenkins-todo-deployer
---
# ---------- NFS-backed PersistentVolume for Jenkins home ---------------------
apiVersion: v1
kind: PersistentVolume
metadata:
  name: jenkins-pv
spec:
  capacity:
    storage: {{ jenkins_storage_size }}
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  nfs:
    server: {{ services_ip }}
    path: {{ jenkins_nfs_path }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: jenkins-home
  namespace: {{ jenkins_namespace }}
spec:
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: {{ jenkins_storage_size }}
  storageClassName: ""
  volumeName: jenkins-pv
